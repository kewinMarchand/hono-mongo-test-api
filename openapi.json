{
    "openapi": "3.1.0",
    "info": {
        "title": "API de test Kewin",
        "description": "API de test commune aux boilerplates front (Next, Nuxt, SvelteKit, Symfony Twig, HTML).\nImplémentation Hono, zod et MongoDB, interchangeable avec api-platform-test-api : mêmes chemins, mêmes paramètres, mêmes formes JSON.\nFormat : JSON simple (`application/json`).\nEn dev et en test, l'en-tête `X-Scenario: error` renvoie une 500 et `X-Scenario: empty` une collection vide.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": ""
        }
    ],
    "components": {
        "schemas": {
            "Task": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "done": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "title",
                    "done"
                ],
                "description": "Liste toutes les tâches, sans pagination."
            },
            "Article": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "excerpt": {
                        "type": "string"
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date"
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "title",
                    "excerpt",
                    "publishedAt"
                ],
                "description": "Liste les articles, du plus récent au plus ancien, sans pagination."
            },
            "ContactMessage": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "readOnly": true
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 2,
                        "maxLength": 255
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255,
                        "format": "email"
                    },
                    "message": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 10,
                        "maxLength": 5000
                    },
                    "receivedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "name",
                    "email",
                    "message"
                ],
                "description": "Enregistre un message de contact. Répond 422 avec la liste des violations si un champ est invalide."
            },
            "Error": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A short, human-readable summary of the problem."
                    },
                    "detail": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A human-readable explanation specific to this occurrence of the problem."
                    },
                    "status": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "default": 400,
                        "examples": [
                            404
                        ]
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A URI reference that identifies the specific occurrence of the problem. It may or may not yield further information if dereferenced."
                    },
                    "type": {
                        "type": "string",
                        "readOnly": true,
                        "description": "A URI reference that identifies the problem type"
                    }
                },
                "description": "A representation of common errors."
            },
            "ConstraintViolation": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "integer",
                        "default": 422
                    },
                    "violations": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "propertyPath": {
                                    "type": "string",
                                    "description": "The property path of the violation"
                                },
                                "message": {
                                    "type": "string",
                                    "description": "The message associated with the violation"
                                },
                                "code": {
                                    "type": "string",
                                    "description": "The code of the violation"
                                },
                                "hint": {
                                    "type": "string",
                                    "description": "An extra hint to understand the violation"
                                },
                                "payload": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "description": "The serialized payload of the violation"
                                }
                            },
                            "required": [
                                "propertyPath",
                                "message"
                            ]
                        }
                    },
                    "detail": {
                        "type": "string",
                        "readOnly": true
                    },
                    "type": {
                        "type": "string",
                        "readOnly": true
                    },
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true
                    }
                },
                "description": "Unprocessable entity"
            },
            "Category": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "parent": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Slug de la catégorie parente, null à la racine."
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Category"
                        }
                    }
                },
                "required": [
                    "slug",
                    "name",
                    "parent",
                    "children"
                ],
                "description": "Renvoie l'arbre des catégories : les catégories racines, chacune avec ses enfants, triées par position."
            },
            "ProductList": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductItem"
                        }
                    },
                    "totalItems": {
                        "type": "integer",
                        "description": "Nombre total de produits filtrés, toutes pages confondues."
                    },
                    "page": {
                        "type": "integer"
                    },
                    "itemsPerPage": {
                        "type": "integer"
                    },
                    "totalPages": {
                        "type": "integer",
                        "description": "Nombre de pages, 0 si aucun résultat."
                    },
                    "facets": {
                        "$ref": "#/components/schemas/ProductFacets"
                    }
                },
                "required": [
                    "items",
                    "totalItems",
                    "page",
                    "itemsPerPage",
                    "totalPages",
                    "facets"
                ],
                "description": "Liste les produits du catalogue. Les filtres se combinent en ET, les valeurs d'une même facette en OU. Une valeur invalide (inconnue, non numérique, hors bornes) est ignorée et remplacée par la valeur par défaut."
            },
            "ProductItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "categorySlug": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Prix en centimes."
                    },
                    "exposure": {
                        "type": "string",
                        "enum": [
                            "soleil",
                            "mi-ombre",
                            "ombre"
                        ]
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ]
                    },
                    "inStock": {
                        "type": "boolean"
                    },
                    "image": {
                        "type": "integer",
                        "description": "Index du visuel partagé, de 1 à 12."
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "categorySlug",
                    "price",
                    "exposure",
                    "size",
                    "inStock",
                    "image"
                ]
            },
            "ProductFacets": {
                "type": "object",
                "properties": {
                    "exposure": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetValue"
                        },
                        "description": "Toutes les expositions, y compris à 0."
                    },
                    "size": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetValue"
                        },
                        "description": "Toutes les tailles, y compris à 0."
                    },
                    "category": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryFacetValue"
                        },
                        "description": "Sous-catégories directes de la catégorie filtrée (catégories racines sans filtre). Vide sur une feuille."
                    }
                },
                "required": [
                    "exposure",
                    "size",
                    "category"
                ]
            },
            "FacetValue": {
                "type": "object",
                "properties": {
                    "value": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Nombre de produits obtenus en ajoutant cette valeur aux filtres des autres facettes."
                    }
                },
                "required": [
                    "value",
                    "count"
                ]
            },
            "CategoryFacetValue": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Nombre de produits de cette sous-catégorie qui respectent les autres filtres."
                    }
                },
                "required": [
                    "slug",
                    "name",
                    "count"
                ]
            }
        },
        "parameters": {}
    },
    "paths": {
        "/api/tasks": {
            "get": {
                "operationId": "api_tasks_get_collection",
                "tags": [
                    "Task"
                ],
                "summary": "Retrieves the collection of Task resources.",
                "description": "Retrieves the collection of Task resources.",
                "responses": {
                    "200": {
                        "description": "Task collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Task"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/articles": {
            "get": {
                "operationId": "api_articles_get_collection",
                "tags": [
                    "Article"
                ],
                "summary": "Retrieves the collection of Article resources.",
                "description": "Retrieves the collection of Article resources.",
                "responses": {
                    "200": {
                        "description": "Article collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Article"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/contact_messages": {
            "post": {
                "operationId": "api_contact_messages_post",
                "tags": [
                    "ContactMessage"
                ],
                "summary": "Creates a ContactMessage resource.",
                "description": "Creates a ContactMessage resource.",
                "requestBody": {
                    "required": true,
                    "description": "The new ContactMessage resource",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 2,
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255,
                                        "format": "email"
                                    },
                                    "message": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 10,
                                        "maxLength": 5000
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "ContactMessage resource created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContactMessage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "413": {
                        "description": "Payload too large",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "An error occurred",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConstraintViolation"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConstraintViolation"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories": {
            "get": {
                "operationId": "api_categories_get_collection",
                "tags": [
                    "Category"
                ],
                "summary": "Retrieves the collection of Category resources.",
                "description": "Renvoie l'arbre des catégories : les catégories racines, chacune avec ses enfants, triées par position.",
                "responses": {
                    "200": {
                        "description": "Category collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Category"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "operationId": "api_products_get",
                "tags": [
                    "ProductList"
                ],
                "summary": "Retrieves a ProductList resource.",
                "description": "Liste les produits du catalogue. Les filtres se combinent en ET, les valeurs d'une même facette en OU. Une valeur invalide (inconnue, non numérique, hors bornes) est ignorée et remplacée par la valeur par défaut.",
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "description": "Slug de catégorie : inclut toute la branche. Slug inconnu : 404."
                        },
                        "required": false,
                        "description": "Slug de catégorie : inclut toute la branche. Slug inconnu : 404.",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "soleil",
                                    "mi-ombre",
                                    "ombre"
                                ]
                            },
                            "description": "Expositions acceptées, clé répétée : exposure[]=soleil&exposure[]=ombre."
                        },
                        "required": false,
                        "description": "Expositions acceptées, clé répétée : exposure[]=soleil&exposure[]=ombre.",
                        "name": "exposure[]",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ]
                            },
                            "description": "Tailles acceptées, clé répétée : size[]=S&size[]=M."
                        },
                        "required": false,
                        "description": "Tailles acceptées, clé répétée : size[]=S&size[]=M.",
                        "name": "size[]",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "integer",
                            "description": "Prix minimum inclus, en centimes."
                        },
                        "required": false,
                        "description": "Prix minimum inclus, en centimes.",
                        "name": "priceMin",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "integer",
                            "description": "Prix maximum inclus, en centimes."
                        },
                        "required": false,
                        "description": "Prix maximum inclus, en centimes.",
                        "name": "priceMax",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "boolean",
                            "description": "true : uniquement les produits en stock."
                        },
                        "required": false,
                        "description": "true : uniquement les produits en stock.",
                        "name": "inStock",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "string",
                            "description": "Tri par prix, asc ou desc. Prioritaire sur order[name]. Sans tri : ordre de pertinence."
                        },
                        "required": false,
                        "description": "Tri par prix, asc ou desc. Prioritaire sur order[name]. Sans tri : ordre de pertinence.",
                        "name": "order[price]",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "string",
                            "description": "Tri alphabétique (collation française), asc ou desc."
                        },
                        "required": false,
                        "description": "Tri alphabétique (collation française), asc ou desc.",
                        "name": "order[name]",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "description": "Numéro de page, à partir de 1. Au-delà de la dernière page : items vide."
                        },
                        "required": false,
                        "description": "Numéro de page, à partir de 1. Au-delà de la dernière page : items vide.",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "integer",
                            "default": 12,
                            "description": "Produits par page, de 1 à 48."
                        },
                        "required": false,
                        "description": "Produits par page, de 1 à 48.",
                        "name": "itemsPerPage",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ProductList resource",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductList"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "webhooks": {}
}
