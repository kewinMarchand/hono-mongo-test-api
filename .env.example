# Copier en .env pour surcharger les valeurs par défaut (fichier non versionné).
# Les identifiants MongoDB de compose.yaml sont ceux d'une base locale non exposée : aucun secret ici.

# Port publié sur 127.0.0.1
API_PORT=8091

# dev | test | prod. X-Scenario n'est actif qu'en dev et en test.
APP_ENV=dev

# Origines CORS autorisées (expression régulière, insensible à la casse)
CORS_ALLOW_ORIGIN=^http://localhost:(3000|3010|3100|3102|3110|3111|3112|3120|3121|3122|3130|3133|3150|3151|3200|3210|3220|3230|3250|5173|8095)$

# Suivi des erreurs dans GlitchTip (DSN au format Sentry). Vide : SDK non initialisé, rien n'est envoyé.
GLITCHTIP_DSN=
# Environnement remonté avec chaque erreur. Vide : la valeur de APP_ENV.
GLITCHTIP_ENVIRONMENT=
